{
  "name": "wayfound",
  "main": "worker/liveStats.js",
  "compatibility_date": "2026-11-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "LIVE_STATS", "class_name": "LiveStats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveStats"] }],
  "previews": {}
}
